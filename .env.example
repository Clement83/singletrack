# Singletrack — configuration. Copy to `.env` (outside git): cp .env.example .env
# Step-by-step guide: docs/install.md.  [REQUIRED] to fill in · [OPTIONAL] sensible default value.

# ── Secrets ─────────────────────────────────────────────────────────────────────────────────────
# [REQUIRED] Better Auth session secret, ≥ 32 characters. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# [REQUIRED in production] Encryption key of the personal invitation links (#1456).
# Generate: openssl rand -base64 32 — NEVER change it afterwards (links already copied would stop opening).
INVITE_LINK_KEY=change-me

# ── Instance address ────────────────────────────────────────────────────────────────────────────
# [REQUIRED] Public URL, no trailing slash (email links, .ics, metadata). Without HTTPS: http://IP:PORT
BETTER_AUTH_URL=https://singletrack.example.org
# [REQUIRED] Origins allowed to sign in (domain + any LAN access), comma-separated.
# Without them, sign-in answers 403.
AUTH_TRUSTED_ORIGINS=https://singletrack.example.org,http://192.0.2.10:3700
# [OPTIONAL] Port published on the host (default 3700).
APP_PORT=3700
# One-off dev server (`dev` profile, app-dev service), LAN only.
APP_DEV_PORT=3701
# [OPTIONAL] `secure` cookie: true behind HTTPS; set false for a test over http://IP:PORT.
AUTH_SECURE_COOKIES=true
# [OPTIONAL] Dev mode (`dev` target of the compose file): hosts allowed behind a reverse proxy or the LAN, comma-separated.
ALLOWED_DEV_ORIGINS=singletrack.example.org,192.0.2.10
# [OPTIONAL] "Source code" link (AGPL §13, #1472): public repository by default; point it to your fork if you modify the code.
# SOURCE_URL=https://github.com/Clement83/singletrack

# ── Comptes ─────────────────────────────────────────────────────────────────────────────────────
# [OPTIONAL] Account creation on first sign-in (#1377): true to close it
# (accounts are then created with `docker compose run --rm tools npm run user:create -- --email <email>`).
AUTH_DISABLE_SIGNUP=false

# ── Mails (connexion par code / lien / QR code) ─────────────────────────────────────────────────
# [REQUIRED for sign-in as long as emails are not sent] Resend "sending access" key;
# the sending domain must be verified at Resend. Without a key: no email, the code is written to the app logs.
RESEND_API_KEY=
# [REQUIRED with Resend] Sender, on a domain verified at Resend.
MAIL_FROM="Singletrack <no-reply@example.org>"

# ── Map and area (#1473) ────────────────────────────────────────────────────────────────────────
# [OPTIONAL] "Home" point: map centre on opening and reference of the "distance from home" filter.
# Default: centre of France (46.6, 2.4). Put your coordinates (right click on Google Maps / OSM).
HOME_LAT=46.6
HOME_LON=2.4
# [OPTIONAL] Departments (INSEE codes, comma-separated) imported by `npm run sync:osm`, `sync:singles` and `sync:datatourisme`
# when none are passed as arguments. Empty = all of metropolitan France (long: several hours).
# Exemples : 83 · 83,06,13 · 2A,2B
SYNC_ZONES=
# [OPTIONAL] Active data sources, comma-separated (empty = all):
#   osm        OpenStreetMap mountain-bike routes and singletracks (sync)
#   geotrek    official mountain-bike routes of the parks (sync)
#   datatourisme  tourist office mountain-bike circuits (sync, key DATA_TOURISM_API_KEY below)
#   ign        elevation of tracks without elevation (IGN API, France only)
#   openmeteo  weather of an outing
#   fire83     fire risk of the forest massifs — Var only, "not available" elsewhere
#   hunting83  driven hunts — Var only, "not available" elsewhere
# Outside the Var, fire and hunting show nothing anyway: removing them avoids the fire scheduler.
# DATA_SOURCES=osm,geotrek,datatourisme,ign,openmeteo,fire83,hunting83

# [OPTIONAL] DATAtourisme API key (#1643): mountain-bike circuits published by French tourist offices,
# imported by `npm run sync:datatourisme` (tools service). Free key: https://www.datatourisme.fr/utiliser-les-donnees
# Empty = that sync is skipped. Never commit it; the sync never logs it.
DATA_TOURISM_API_KEY=

# ── Installation (distribution compose.yml, #1484) ──────────────────────────────────────────────
# [OPTIONAL] BRouter tiles downloaded on first start: france (≈ 770 MB, default) · home (tile of the home point)
# · list E5_N40,W5_N40 · none. Without tiles, snapping fails cleanly and the editor falls back to straight lines.
# BROUTER_TILES=france
# [OPTIONAL] Image version: latest (last release), X.Y.Z, or edge (latest commit on main).
# SINGLETRACK_TAG=latest
# Container user = owner of ./data (set by scripts/init-env.sh).
# APP_UID=1000
# APP_GID=1000

# ── Technical (docker-compose values, change them only to point elsewhere) ─────────────────────
# Path of the SQLite file in the container (./data on the host, through the `./data:/app/data` volume; photos in ./data/media).
DATABASE_URL=/app/data/singletrack.db
# Outing photos and videos (#1693): defaults to `media/` next to the database (./data/media). Can point to another
# disk mounted in the container (add the volume in the compose file).
# MEDIA_DIR=/app/data/media
# Short-video encoder: auto (default: Intel iGPU via QSV when /dev/dri is mounted, otherwise libx264) | qsv | x264.
# VIDEO_ENCODER=auto
# Host `render` group, to give the container access to /dev/dri (compose `group_add`).
# RENDER_GID=109
# BRouter (self-hosted mountain-bike routing).
# BROUTER_URL=http://brouter:17777
# Overpass (OSM) and Open-Meteo: alternative instances.
# OVERPASS_URL=
# OPEN_METEO_URL=

# ── ActivityPub federation (#1474, docs/federation.md) ──────────────────────────────────────────
# [OPTIONAL] on|off. Defaults to `on` as soon as FEDERATION_KEY_ENC is set (#1477); `off`: no ActivityPub route
# answers (404) and nothing is sent. Instance open to every server: see ADMIN_EMAILS and /admin/federation.
# FEDERATION=on
# [OPTIONAL] Administrator emails (comma-separated): access to /admin/federation (blocked servers, reports, rejections).
# ADMIN_EMAILS=
# [REQUIRED if FEDERATION=on] Encrypts the accounts' private keys (AES-256-GCM): `openssl rand -base64 32`.
# Keep it, never change it (back it up with .env). The federated address is handle@domain of BETTER_AUTH_URL
# (or PUBLIC_URL if set); HTTPS required in production.
FEDERATION_KEY_ENC=
# [OPTIONAL] SQLite file of the Fedify delivery queue and cache (default ./data/federation.db).
# FEDERATION_DB=
# Development only, never in production: allows HTTP and private addresses (docker network).
# FEDERATION_DEV_HTTP=1
